# Copy to .env and fill in; never commit values (docs/architecture/environments.md, section 2).
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
AUTH_SECRET=
APP_URL=
DOMAIN=
TRUST_PROXY=
# age public key (age1...) the backups are encrypted for; the matching private key is kept off the server.
BACKUP_ENCRYPTION_KEY=
LOG_LEVEL=
NODE_ENV=
# Version of the images to run in production (e.g. 0.1.0, matching the vX.Y.Z tag); never `latest`. Local builds use `dev`.
CRENO_VERSION=
