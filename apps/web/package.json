{
  "name": "@creno/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project components",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "db:deploy": "tsx --env-file-if-exists=../../.env prisma/tools.ts migrate",
    "db:migrate": "pnpm db:deploy && prisma generate --schema prisma/schema.prisma",
    "db:rollback": "tsx --env-file-if-exists=../../.env prisma/tools.ts rollback",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "db:purge": "tsx --env-file-if-exists=../../.env scripts/purge.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@creno/validation": "workspace:*",
    "@hookform/resolvers": "^5.9.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "jose": "^5.10.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@creno/tokens": "workspace:*",
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "^15.5.28",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.31",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
