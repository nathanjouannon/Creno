# Reverse proxy (environments.md, section 5): automatic HTTPS and HTTP→HTTPS redirect, security headers of security.md, section 4.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Pages carry the application's own policy, with a nonce per page (#80); `?` only sets this one on the responses
		# that have none (API, static files), so the two never stack.
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		-Server
	}

	# Caddy sets X-Forwarded-For from the real client address and drops any value sent by the client (TRUST_PROXY).
	reverse_proxy app:3000
}
