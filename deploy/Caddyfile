# Reverse proxy (environments.md, section 5): automatic HTTPS and HTTP→HTTPS redirect, security headers of security.md, section 4.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Next.js injects inline bootstrap scripts, so script-src needs 'unsafe-inline' until a per-request nonce is set by the app.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		-Server
	}

	# Second barrier behind the application's 128 KiB limit on request bodies (security.md, section 4): answers 413.
	request_body {
		max_size 1MB
	}

	# Caddy sets X-Forwarded-For from the real client address and drops any value sent by the client (TRUST_PROXY).
	reverse_proxy app:3000
}
