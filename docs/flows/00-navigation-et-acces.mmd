%% Navigation globale et contrôle d'accès (F-03, RG-04)
%% Légende : rectangle = écran, stade = action, losange = décision, rouge = erreur / refus, orange = à confirmer
flowchart TD
    classDef error fill:#fde2e2,stroke:#dc2626,color:#111
    classDef todo fill:#fff1d6,stroke:#d97706,color:#111

    V(["Ouverture d'une URL du club"]) --> G{"Utilisateur connecté ?"}
    G -->|"Non"| LOGIN["Page de connexion (flux 02)"]
    G -->|"Oui"| R{"Page réservée aux administrateurs ?"}
    R -->|"Non"| PAGE["Page demandée"]
    R -->|"Oui"| ADM{"Est administrateur ?"}
    ADM -->|"Oui"| PAGE
    ADM -->|"Non"| DENY["Accès refusé : Tu n'as pas le droit d'accéder à cette page"]:::error

    API(["Requête d'administration envoyée directement au serveur"]) --> ADM2{"Est administrateur ?"}
    ADM2 -->|"Oui"| OK["Action exécutée"]
    ADM2 -->|"Non"| DENY2["Requête refusée, rien n'est modifié"]:::error

    subgraph HEADER["En-tête, visible sur toutes les pages une fois connecté"]
        direction TB
        H1["Navigation : Événements"]
        H2["Navigation, administrateur uniquement : Événements passés, Membres"]
        H3["Menu du prénom, en haut à droite : Se déconnecter, Supprimer mon compte"]
    end

    H3 -->|"Se déconnecter"| LOGIN
    H3 -->|"Supprimer mon compte"| DEL["Suppression du compte (flux 08)"]
    H1 --> LIST["Liste des événements (flux 04)"]
    H2 --> ADMP["Pages d'administration (flux 06 et 07)"]
