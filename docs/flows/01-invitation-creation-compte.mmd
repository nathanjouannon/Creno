%%{init: {"flowchart": {"htmlLabels": true, "wrappingWidth": 360, "padding": 24, "nodeSpacing": 50, "rankSpacing": 60, "curve": "basis"}, "themeVariables": {"fontSize": "15px"}}}%%
%% Invitation et création de compte (F-01, RG-01, RG-02)
%% Légende : rectangle = écran, stade = action, losange = décision, rouge = erreur / refus, orange = à confirmer
flowchart TD
    classDef error fill:#fde2e2,stroke:#dc2626,color:#111
    classDef todo fill:#fff1d6,stroke:#d97706,color:#111

    subgraph ADMIN["Administrateur"]
        A1["Page d'un événement"] --> A2{"Événement commencé ? (RG-02)"}
        A2 -->|"Oui"| A3["Bouton « Inviter des bénévoles »<br/>masqué"]
        A2 -->|"Non"| A4["Bouton « Inviter des bénévoles »<br/>affiché"]
        A4 -->|"Clic"| A5["Lien affiché, avec date de fin de<br/>validité (début de l'événement) et<br/>bouton Copier"]
    end

    A5 -.->|"Diffusé hors application<br/>(canal habituel du club)"| B0

    subgraph INVITE["Personne invitée"]
        B0(["Ouvre le lien d'invitation"]) --> B1{"Lien valide ? (RG-02)"}
        B1 -->|"Non : événement commencé"| B2["Aucun compte créé : Ce lien n'est<br/>plus valide, demande un nouveau<br/>lien à un administrateur"]:::error
        B1 -->|"Oui"| BM["Mémorisation de l'événement de<br/>l'invitation dans l'état<br/>temporaire du navigateur"]
        BM --> B3["Formulaire : nom, prénom, e-mail,<br/>mot de passe"]
        B3 -->|"Clic « Créer mon compte »"| B4{"Données valides ?"}
        B4 -->|"Nom, prénom ou e-mail vide<br/>ou mal formé"| B8["Toast : Renseigne ton nom, ton<br/>prénom et une adresse e-mail<br/>valide, champs conservés"]:::error
        B8 --> B3
        B4 -->|"Mot de passe de moins de 10<br/>caractères (RG-01)"| B5["Le mot de passe doit contenir au<br/>moins 10 caractères, autres champs<br/>conservés"]:::error
        B5 --> B3
        B4 -->|"E-mail déjà utilisé (RG-01)"| B6["Aucun second compte : message qui<br/>propose de se connecter"]:::error
        B6 --> B7["Page de connexion (flux 02) :<br/>l'état mémorisé est conservé"]
        B7 -.->|"Après connexion"| B10
        B4 -->|"Oui"| B9["Compte actif et utilisateur<br/>connecté"]
        B9 --> B10["Redirection vers la page de<br/>l'événement mémorisé, prénom en<br/>haut à droite, puis état<br/>temporaire effacé"]
    end

    %% État temporaire : simple mémoire du navigateur (par exemple un store de type Zustand), choix technique laissé à la phase architecture.
    %% Une instance = une association (PRD section 6) : seul l'événement est mémorisé, le club est implicite.
    NOTE["État temporaire : identifiant de<br/>l'événement de l'invitation, perdu<br/>à la fermeture de l'onglet<br/>(comportement à valider en phase<br/>architecture)"]
    BM -.- NOTE
