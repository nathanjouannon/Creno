%%{init: {"flowchart": {"htmlLabels": true, "wrappingWidth": 360, "padding": 24, "nodeSpacing": 50, "rankSpacing": 60, "curve": "basis"}, "themeVariables": {"fontSize": "15px"}}}%%
%% Connexion et déconnexion (F-02, RG-03)
%% Légende : rectangle = écran, stade = action, losange = décision, rouge = erreur / refus, orange = à confirmer
flowchart TD
    classDef error fill:#fde2e2,stroke:#dc2626,color:#111
    classDef todo fill:#fff1d6,stroke:#d97706,color:#111

    S(["Ouvre une page protégée sans être<br/>connecté"]) --> L["Page de connexion : e-mail, mot de<br/>passe"]
    S2(["Ouvre directement la page de<br/>connexion"]) --> L

    L -->|"Clic « Se connecter »"| C{"Connexion bloquée pour cette adresse ?<br/>(RG-03, compte existant ou non)"}
    C -->|"Oui : 5 échecs consécutifs,<br/>15 minutes"| E1["Message indiquant le blocage de 15<br/>minutes, même avec le bon mot de<br/>passe ; même message<br/>si l'adresse n'a pas de compte"]:::error
    E1 --> L
    C -->|"Non"| D{"Identifiants corrects ?"}
    D -->|"Non (y compris compte<br/>supprimé)"| E2["Reste sur la page : E-mail ou mot<br/>de passe incorrect, champ mot de<br/>passe vidé, un échec de plus"]:::error
    E2 --> L
    D -->|"Oui"| OK["Utilisateur connecté"]
    OK --> T{"Destination mémorisée dans l'état<br/>temporaire du navigateur ?"}
    T -->|"Oui : URL demandée ou<br/>événement d'une invitation"| P1["Redirection vers cette page, puis<br/>état temporaire effacé"]
    T -->|"Non"| P2["Liste des événements, prénom en<br/>haut à droite"]

    %% La destination est mémorisée avant d'arriver sur la page de connexion :
    %% - URL protégée ouverte sans être connecté (flux 00)
    %% - événement d'une invitation (flux 01)
    %% L'état temporaire est une mémoire du navigateur (par exemple un store de type Zustand), choix technique laissé à la phase architecture.
    NOTE["Si la destination mémorisée<br/>n'existe plus ou n'est plus<br/>accessible : comportement à<br/>CONFIRMER"]:::todo
    T -.- NOTE

    subgraph OUT["Déconnexion"]
        direction TB
        O1["Menu du prénom"] -->|"Clic « Se déconnecter »"| O2["Page de connexion"]
        O2 --> O3["Les pages protégées redemandent la<br/>connexion"]
    end
