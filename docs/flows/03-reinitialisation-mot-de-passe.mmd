%%{init: {"flowchart": {"htmlLabels": true, "wrappingWidth": 360, "padding": 24, "nodeSpacing": 50, "rankSpacing": 60, "curve": "basis"}, "themeVariables": {"fontSize": "15px"}}}%%
%% Mot de passe oublié : réinitialisation par lien généré par l'administrateur (F-02, F-10, RG-01, RG-12, RG-13)
%% Aucun e-mail n'est envoyé au MVP (RG-13) : l'administrateur transmet lui-même le lien.
%% Légende : rectangle = écran, stade = action, losange = décision, rouge = erreur / refus, orange = à confirmer
%% Lien (T-018) : `{APP_URL}/reinitialisation/{jeton}` ; la page qui l'ouvre vient avec T-019.
flowchart TD
    classDef error fill:#fde2e2,stroke:#dc2626,color:#111

    M(["Un membre a oublié son mot de<br/>passe"]) -.->|"Contacte l'administrateur<br/>hors application"| A1

    subgraph ADMIN["Administrateur"]
        A1["Fiche du membre (flux 07)"] -->|"Clic « Générer un lien de<br/>réinitialisation »"| A2["Lien à usage unique affiché, avec<br/>date de fin de validité (3 jours)<br/>et bouton Copier ; les liens<br/>précédents du membre sont<br/>invalidés (RG-12)"]
    end

    A2 -.->|"Transmis par<br/>l'administrateur au membre"| B0

    subgraph MEMBRE["Membre"]
        B0(["Ouvre le lien de réinitialisation"]) --> B1{"Lien valide ? (non utilisé, moins<br/>de 3 jours, RG-12)"}
        B1 -->|"Non"| B2["Ce lien n'est plus valide, demande<br/>un nouveau lien à un<br/>administrateur"]:::error
        B1 -->|"Oui"| B3["Formulaire : nouveau mot de passe"]
        B3 -->|"Valide"| B4{"10 caractères ou plus ? (RG-01)"}
        B4 -->|"Non"| B5["Le mot de passe doit contenir au<br/>moins 10 caractères"]:::error
        B5 --> B3
        B4 -->|"Oui"| B6["Mot de passe changé, lien<br/>désormais inutilisable, sessions<br/>ouvertes fermées, blocage de<br/>connexion levé (RG-12, RG-03)"]
        B6 --> B7["Page de connexion : connexion avec<br/>le nouveau mot de passe (flux 02)"]
    end
