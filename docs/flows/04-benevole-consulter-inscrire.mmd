%%{init: {"flowchart": {"htmlLabels": true, "wrappingWidth": 360, "padding": 24, "nodeSpacing": 50, "rankSpacing": 60, "curve": "basis"}, "themeVariables": {"fontSize": "15px"}}}%%
%% Utilisateur : consulter, s'inscrire, se désinscrire, changer de créneau (F-06, F-07, F-08, RG-07, RG-08, RG-09)
%% Un administrateur voit les mêmes boutons « Je m'inscris » et « Me désinscrire » sur sa page de l'événement (flux 06, RG-08).
%% Légende : rectangle = écran, stade = action, losange = décision, rouge = erreur / refus, orange = à confirmer
flowchart TD
    classDef error fill:#fde2e2,stroke:#dc2626,color:#111
    classDef todo fill:#fff1d6,stroke:#d97706,color:#111

    H(["Utilisateur connecté ouvre la page<br/>d'accueil"]) --> LOAD["Chargement de la liste"]
    LOAD --> Q{"Événements à venir ?"}
    Q -->|"Aucun"| EMPTY["Aucun événement à venir pour le<br/>moment"]
    Q -->|"Oui"| LIST["Liste par date de début croissante<br/>: titre, lieu, date (événements<br/>passés masqués, RG-09)"]
    LIST -->|"Clic sur un événement"| EV["Page de l'événement : description,<br/>lieu, dates, créneaux"]
    URL(["URL directe d'un événement passé<br/>(utilisateur sans droit administrateur)"]) --> URLR["Page introuvable (RG-09)"]:::error

    EV --> NS{"L'événement a des créneaux ?"}
    NS -->|"Non"| NS1["Affichage d'un événement sans<br/>créneau : texte à CONFIRMER"]:::todo
    NS -->|"Oui"| SL["Pour chaque créneau : horaires,<br/>noms des inscrits (RG-09)"]
    SL --> ST{"État du créneau pour cet<br/>utilisateur"}

    ST -->|"Commencé, utilisateur non<br/>inscrit (RG-08)"| S1["Ce créneau a commencé :<br/>inscription impossible"]:::error
    ST -->|"Commencé, utilisateur<br/>inscrit (RG-08)"| S2["Pas de bouton Me désinscrire :<br/>Contacte un administrateur pour<br/>modifier ton inscription (il peut<br/>retirer l'inscription, flux 06)"]:::error
    ST -->|"À venir, utilisateur inscrit"| S3["Bouton « Me désinscrire »"]
    ST -->|"À venir, limité et complet,<br/>non inscrit"| S4["Mention « Complet », inscription<br/>indisponible"]
    ST -->|"À venir, avec places, non<br/>inscrit"| S5["Bouton « Je m'inscris », places<br/>restantes affichées si le créneau<br/>est limité"]

    S5 -->|"Clic « Je m'inscris »"| R{"Place encore disponible ? (RG-07)"}
    R -->|"Non : dernière place prise<br/>entre-temps"| R1["Ce créneau vient d'être complété,<br/>limite non dépassée"]:::error
    R1 --> SL
    R -->|"Oui"| R2["Inscription enregistrée : nom dans<br/>la liste, bouton « Me<br/>désinscrire », places restantes<br/>moins 1 si limité"]
    R2 --> S3

    S3 -->|"Clic « Me désinscrire »"| U0{"Confirmation de la désinscription"}
    U0 -->|"Refuse"| U2["Inscription conservée"]
    U2 --> S3
    U0 -->|"Confirme"| U1["Nom retiré de la liste, place<br/>libérée, bouton « Je m'inscris »"]
    U1 --> S5

    CH(["Changer de créneau : se<br/>désinscrire de A (avec<br/>confirmation), puis s'inscrire à B"]) -.-> S3
    CH -.-> S5
    S4 -.->|"Si B est complet :<br/>inscription à B refusée,<br/>inscription à A conservée"| S3

    %% Plusieurs inscriptions sur des créneaux qui se chevauchent sont autorisées sans avertissement (RG-08).
