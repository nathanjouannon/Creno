{
  "name": "creno",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm tokens:build && pnpm --filter @creno/web dev",
    "build": "pnpm tokens:build && pnpm --filter @creno/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "tokens:build": "pnpm --filter @creno/tokens build",
    "db:migrate": "pnpm --filter @creno/web db:migrate",
    "db:rollback": "pnpm --filter @creno/web db:rollback",
    "db:seed": "pnpm --filter @creno/web db:seed",
    "db:purge": "pnpm --filter @creno/web db:purge",
    "api:generate": "pnpm --filter @creno/validation api:generate",
    "api:check": "pnpm --filter @creno/validation api:check",
    "api:lint": "redocly lint docs/api/openapi.yaml",
    "test:e2e": "pnpm --filter @creno/web test:e2e"
  },
  "devDependencies": {
    "@redocly/cli": "^2.71.1",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ],
    "overrides": {
      "next>postcss": "^8.5.23",
      "deepmerge-ts": "^8.0.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
